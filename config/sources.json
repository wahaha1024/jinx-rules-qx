{
  "repository": "VME98/jinx-rules",
  "branch": "master",

  "safe_mode": true,
  "deduplicate": true,
  "convert_generic_path": false,
  "convert_unknown_url": false,
  "convert_regex": false,

  "single_filter_output": "jinx-adblock-qx.list",

  "extra_sources": [
    {
      "name": "fuck_apps_ad_sr",
      "type": "sgmodule",
      "url": "https://raw.githubusercontent.com/uxudjs/Shadowrocket/refs/heads/main/modules/fuck_apps_ad_sr.sgmodule",
      "include_rule_section": true,
      "include_url_rewrite": true
    },
    {
      "name": "manual_extras",
      "type": "manual",
      "path": "config/manual_extras.list"
    }
  ],

  "sources": {
    "domain": {
      "blacklist": [
        "rules/blacklist.txt",
        "rules/blacklist_wildcard.txt",
        "rules/domain_blacklist.txt"
      ],
      "whitelist": [
        "rules/whitelist.txt",
        "rules/whitelist_wildcard.txt",
        "rules/domain_whitelist.txt"
      ]
    },
    "url": {
      "blacklist": [
        "rules/url_blacklist.txt",
        "rules/url_blacklist_paths.txt",
        "rules/url_blacklist_domain_paths.txt"
      ],
      "whitelist": [
        "rules/url_whitelist.txt",
        "rules/url_whitelist_paths.txt"
      ]
    },
    "mitm_skip": [
      "rules/mitm_skip_domains.txt"
    ]
  }
}
